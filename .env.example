# Copy to `.env` and adjust. `.env` is gitignored; never commit real secrets.
# Docker Compose reads `.env` automatically. Every variable below has a default
# in docker-compose.yml, so the stack also starts without a `.env` file.
# Later steps (backend, worker, viewer) will add their variables here.

# ---------------------------------------------------------------------------
# PostgreSQL (database for the Django backend, Step 5)
# ---------------------------------------------------------------------------
# Database name, user and password created on first start of the container.
# Changing them later requires deleting the `postgres-data` volume.
POSTGRES_DB=colibrimo
POSTGRES_USER=colibrimo
POSTGRES_PASSWORD=colibrimo-dev-password
# Port on your machine (host). Change it if 5432 is already used locally.
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis (Celery job queue, Step 5)
# ---------------------------------------------------------------------------
# Port on your machine (host). Change it if 6379 is already used locally.
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# MinIO (S3-compatible object storage: videos, frames, splat files)
# Image: pgsty/minio, a community fork of MinIO (see docs/decisions.md).
# ---------------------------------------------------------------------------
# Admin login for the MinIO console and S3 API. Password: at least 8 characters.
MINIO_ROOT_USER=colibrimo
MINIO_ROOT_PASSWORD=colibrimo-dev-password
# S3 API port (apps and the pipeline talk to this one).
MINIO_API_PORT=9000
# Web console port: open http://localhost:9001 in a browser.
MINIO_CONSOLE_PORT=9001
# Folder on your machine where MinIO stores its files. Relative paths are
# relative to the repo root. Point it at a drive with enough free space,
# e.g. D:/colibrimo-storage on Windows. Room videos are personal data: keep
# this folder out of Git and cloud-synced folders.
MINIO_DATA_DIR=./data/minio
# Bucket created automatically on startup by the `minio-init` service.
S3_BUCKET=colibrimo
